{
  "name": "@rpg-jev/terminal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "play": "node --env-file-if-exists=../../.env src/play.ts",
    "demo": "node --env-file-if-exists=../../.env src/demo.ts",
    "routes": "node --env-file-if-exists=../../.env src/routes.ts",
    "friction": "node src/friction.ts",
    "sdlc": "node src/sdlc.ts"
  },
  "dependencies": {
    "@rpg-jev/core": "workspace:*",
    "@rpg-jev/inn": "workspace:*",
    "@rpg-jev/jev": "workspace:*"
  }
}
