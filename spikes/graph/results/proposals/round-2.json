      },
      {
        "id": "flaw-in-fire",
        "says": "Strong heat finds the hidden flaw in something brittle: heated scorching hot, a flawed thing cracks where a sound one comes through whole",
        "about": "tgt",
        "first": [
          {
            "when": {
              "all": [
                {
                  "a": "tgt.was.flaw",
                  "is": ">",
                  "b": 0
                },
                {
                  "a": "tgt.p.toughness",
                  "is": "<=",
                  "b": 1.5
                },
                {
                  "a": "tgt.p.meltsAt",
                  "is": "<=",
                  "b": 0
                },
                {
                  "ref": "tgt.row.is.liquid",
                  "equals": false
                },
                {
                  "a": "tgt.was.temperature",
                  "is": "<",
                  "b": 4
                },
                {
                  "a": "tgt.s.temperature",
                  "is": ">=",
                  "b": 4
                }
              ]
            },
            "effects": [
              {
                "kind": "set",
                "q": "tgt.s.integrity",
                "to": {
                  "op": "min",
                  "of": [
                    "tgt.s.integrity",
                    {
                      "op": "max",
                      "of": [
                        1,
                        {
                          "op": "sub",
                          "of": [
                            4,
                            "tgt.was.flaw"
                          ]
                        }
                      ]
                    }
                  ]
                },
                "lo": 0,
                "hi": 5
              }
            ],
            "because": [
              "S15",
              "P4",
              "S1",
              "S4",
              "X3"
            ],
            "note": "the heat finds the flaw in it, and it cracks"
          }
        ]
      }
    ]
  },
  "strike": {
    "factors": {
      "wear": [
        {
          "if": {
            "a": "d.grain",
            "is": ">",
            "b": 0
          },
          "then": 0.2,
          "else": 1
        }
      ],
      "cutShare": [
        {
          "if": {
            "all": [
              {
                "ref": "tool.row.is.pointed",
                "equals": true
              },
              {
                "ref": "tool.row.is.edged",
                "equals": false
              }
            ]
          },
          "then": 0.15,
          "else": 1
        }
      ]
    },
    "factorSays": {
      "wear": "An edge worked along the grain of what it cuts wears far less than one forced across the grain, because the stuff parts ahead of the edge",
      "cutShare": "A point makes only a small hole where an edge makes a long cut, so piercing a thing harms it far less than slashing it"
    },
    "rules": [
      {
        "id": "whet",
        "says": "Rubbing an edge or a point with care on something rough and about as hard as itself sharpens it, up to the keenness its own hardness can hold",
        "about": "tgt",
        "first": [
          {
            "when": {
              "all": [
                {
                  "a": "act.surface",
                  "is": ">",
                  "b": 0
                },
                {
                  "a": "tool.was.edge",
                  "is": "<=",
                  "b": 0
                },
                {
                  "a": "tool.p.friction",
                  "is": ">=",
                  "b": 4
                },
                {
                  "a": "tool.p.hardness",
                  "is": ">=",
                  "b": 3
                },
                {
                  "a": "tool.p.hardness",
                  "is": ">=",
                  "b": {
                    "op": "sub",
                    "of": [
                      "tgt.p.hardness",
                      1
                    ]
                  }
                },
                {
                  "any": [
                    {
                      "ref": "tgt.row.is.edged",
                      "equals": true
                    },
                    {
                      "ref": "tgt.row.is.pointed",
                      "equals": true
                    }
                  ]
                },
                {
                  "a": "tgt.was.edge",
                  "is": "<",
                  "b": "d.keenest"
                }
              ]
            },
            "effects": [
              {
                "kind": "set",
                "q": "tgt.s.edge",
                "to": {
                  "op": "add",
                  "of": [
                    "tgt.was.edge",
                    {
                      "op": "mul",
                      "of": [
                        {
                          "op": "sub",
                          "of": [
                            "d.keenest",
                            "tgt.was.edge"
                          ]
                        },
                        {
                          "op": "add",
                          "of": [
                            0.15,
                            {
                              "op": "mul",
                              "of": [
                                0.05,
                                "act.care"
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                "lo": 0,
                "hi": 5
              }
            ],
            "because": [
              "S5",
              "P3",
              "P14",
              "X2"
            ],
            "note": "the stone brings up its edge"
          }
        ]
      },
      {
        "id": "loose-comes-away",
        "says": "What is loose and granular needs no edge to work it: a hand or a tool driven into it brings some away, more for the effort and the size of what digs",
        "about": "tgt",
        "first": [
          {
            "when": {
              "all": [
                {
                  "ref": "tgt.row.is.granular",
                  "equals": true
                },
                {
                  "a": "tgt.p.toughness",
                  "is": "<=",
                  "b": 1
                },
                {
                  "a": "tgt.now.p.hardness",
                  "is": "<=",
                  "b": 2
                },
                {
                  "a": "act.effort",
                  "is": ">",
                  "b": 0
                },
                {
                  "any": [
                    {
