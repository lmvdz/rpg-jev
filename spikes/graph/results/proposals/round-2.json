        "first": [
          {
            "effects": [
              {
                "kind": "emit",
                "from": "tgt",
                "channel": "light",
                "strength": {
                  "op": "clamp",
                  "of": [
                    {
                      "op": "add",
                      "of": [
                        2,
                        {
                          "op": "mul",
                          "of": [
                            "tgt.now.p.flammability",
                            0.3
                          ]
                        },
                        {
                          "op": "mul",
