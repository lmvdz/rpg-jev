    "factorSays": {
      "surfaceRate": "Wind fans a fire: what stands near a fire in a wind is brought up to burning heat sooner than it would be in still air",
      "reach": "Wind leans a flame over and carries its heat further, so a fire reaches things in a wind that it would not reach in still air"
    },
    "rules": [
      {
