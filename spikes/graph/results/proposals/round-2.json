    "factorSays": {
      "exposed": "A wet thing dries by what the air can carry off from it: more slowly in the cold and hardly at all once it is frozen, more slowly the more of it is heaped together, more slowly where little air reaches it, and not at all shut in where none does"
    },
    "rules": [
      {
        "id": "holds-its-heat",
        "says": "A great mass of something holds its warmth or its cold long after a little of the same stuff has come to the temperature of the place, and a wind hurries both along",
        "first": [
          {
            "when": {
              "all": [
                {
                  "lacks": "s.burning"
                },
                {
                  "any": [
                    {
                      "a": "s.amount",
                      "is": ">",
                      "b": 1
                    },
                    {
                      "a": "place.wind",
                      "is": ">",
                      "b": 1
                    }
                  ]
                }
              ]
            },
            "effects": [
              {
                "kind": "set",
                "q": "s.temperature",
                "to": {
                  "op": "add",
                  "of": [
                    "place.temperature",
                    {
                      "op": "mul",
                      "of": [
                        {
                          "op": "sub",
                          "of": [
                            "was.temperature",
                            "place.temperature"
                          ]
                        },
                        {
                          "op": "exp",
                          "of": [
                            {
                              "op": "mul",
                              "of": [
                                -1,
                                "d.cools",
                                "t"
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                "lo": 0,
                "hi": 5
              }
            ],
            "because": [
              "S1",
              "S14",
              "P1",
              "R7",
              "X7"
            ],
            "note": "there is a great deal of it, and it is slow to change"
          }
        ]
      },
      {
        "id": "heap-heats",
        "says": "A big damp heap of loose stuff that is going mouldy warms itself from within, the more so the bigger the heap and the further gone it is",
        "first": [
          {
            "when": {
              "all": [
                {
                  "lacks": "s.burning"
                },
                {
                  "ref": "row.is.granular",
                  "equals": true
                },
                {
                  "a": "p.perishability",
                  "is": ">",
                  "b": 0
                },
                {
                  "a": "d.selfHeat",
                  "is": ">",
                  "b": 0
                },
                {
                  "a": "place.air",
                  "is": ">",
                  "b": 0
                },
                {
                  "a": "s.temperature",
                  "is": "<",
                  "b": 4.5
                }
              ]
            },
            "effects": [
              {
                "kind": "set",
                "q": "s.temperature",
                "to": {
                  "op": "add",
                  "of": [
                    "s.temperature",
                    {
                      "op": "mul",
                      "of": [
                        "d.selfHeat",
                        {
                          "op": "sub",
                          "of": [
                            1,
                            {
                              "op": "exp",
                              "of": [
                                {
                                  "op": "mul",
                                  "of": [
                                    -1,
                                    "d.cools",
                                    "t"
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                "lo": 0,
                "hi": 5
              }
            ],
            "because": [
              "S9",
              "S14",
              "S1",
              "S2",
              "X7"
            ],
            "note": "the heap is warm inside"
          }
        ]
      },
      {
        "id": "frost-wedge",
        "says": "Water that freezes inside a crack or in the pores of something brittle swells and forces it wider, a little more with every freeze",
        "first": [
          {
            "when": {
              "all": [
                {
                  "a": "was.temperature",
                  "is": ">",
                  "b": 0.25
                },
                {
                  "a": "s.temperature",
                  "is": "<=",
                  "b": 0.25
                },
                {
                  "a": "s.wetness",
                  "is": ">",
                  "b": 0
                },
                {
                  "a": "wetWith.p.swell",
                  "is": ">",
                  "b": 0
                },
                {
                  "ref": "row.is.liquid",
                  "equals": false
                },
                {
                  "a": "p.toughness",
                  "is": "<=",
                  "b": 2
                },
                {
                  "any": [
                    {
                      "a": "s.flaw",
                      "is": ">",
                      "b": 0
                    },
                    {
                      "a": "s.integrity",
                      "is": "<",
                      "b": 5
                    },
                    {
                      "a": "p.porosity",
                      "is": ">",
                      "b": 0
                    }
                  ]
                }
              ]
            },
            "effects": [
              {
                "kind": "set",
                "q": "s.flaw",
                "to": {
                  "op": "add",
                  "of": [
                    "s.flaw",
                    {
                      "op": "mul",
                      "of": [
                        0.1,
                        "wetWith.p.swell",
                        {
                          "op": "min",
                          "of": [
                            1,
                            "s.wetness"
                          ]
                        }
                      ]
                    }
                  ]
                },
                "lo": 0,
                "hi": 5
              }
            ],
            "because": [
              "P22",
              "S1",
              "S2",
              "S15",
              "P4",
              "X7"
            ],
            "note": "the water in it has frozen and forced it wider"
          }
        ]
      },
      {
        "id": "gust",
        "says": "A strong wind blows out a small flame, though it only fans a big fire",
        "first": [
          {
            "when": {
              "all": [
                {
                  "has": "s.burning"
                },
                {
                  "a": "place.wind",
                  "is": ">=",
                  "b": 4
                },
                {
                  "any": [
                    {
                      "all": [
                        {
                          "a": "p.size",
                          "is": "<=",
                          "b": 1
                        },
                        {
                          "a": "p.mass",
                          "is": "<=",
                          "b": 1
                        }
                      ]
                    },
                    {
                      "all": [
                        {
                          "ref": "s.burning.of",
                          "equals": "coating"
                        },
                        {
                          "a": "s.coating.amount",
                          "is": "<=",
                          "b": 1
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            "effects": [
              {
                "kind": "put",
                "q": "s.burning",
                "value": null
              },
              {
                "kind": "set",
                "q": "s.surfaceAbove",
                "to": 0
              }
            ],
            "because": [
              "S3",
              "R7",
              "P2",
              "X7"
            ],
            "note": "the wind blows it out"
          }
        ]
      },
      {
        "id": "downpour",
        "says": "Heavy rain puts out a fire in the open once what is burning is soaked as far as it can drink",
        "first": [
          {
            "when": {
              "all": [
                {
                  "has": "s.burning"
                },
                {
                  "ref": "s.burning.of",
                  "equals": "self"
                },
                {
                  "a": "place.moisture",
                  "is": ">=",
                  "b": 5
                },
                {
                  "a": "s.wetness",
                  "is": ">=",
                  "b": {
                    "op": "sub",
                    "of": [
                      "d.fill",
                      0.1
                    ]
                  }
                }
              ]
            },
            "effects": [
              {
                "kind": "put",
                "q": "s.burning",
                "value": null
              },
              {
                "kind": "set",
                "q": "s.surfaceAbove",
                "to": 0
              }
            ],
            "because": [
              "S3",
              "S2",
              "X4",
              "X7"
            ],
            "note": "the rain puts it out"
          }
        ]
      }
    ]
  },
