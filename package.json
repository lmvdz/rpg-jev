{
  "name": "rpg-jev",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p validation/thermal-learning/tsconfig.json",
    "test": "vitest run && node --test packages/core/test/thermal/physics.node.test.ts packages/core/test/thermal/integration.node.test.ts packages/core/test/thermal/sweep.node.test.ts packages/terminal/test/thermal.node.test.ts packages/terminal/test/thermal-journal.node.test.ts packages/terminal/test/thermal-surface.node.test.ts packages/terminal/test/thermal-validation.node.test.ts",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "check:unrecorded": "pnpm lint && pnpm typecheck && vitest run --exclude \"**/recorded.test.ts\"",
    "play": "pnpm --filter @rpg-jev/terminal run play",
    "demo": "pnpm --filter @rpg-jev/terminal run demo",
    "friction": "pnpm --filter @rpg-jev/terminal run friction",
    "sdlc": "pnpm --filter @rpg-jev/terminal run sdlc",
    "client": "pnpm --filter @rpg-jev/client run dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^22.20.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
