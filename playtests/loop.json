{
  "enabled": false,
  "max_open_pull_requests": 3,
  "max_snags_per_run": 3,
  "judge_budget_usd_per_run": 0.05,
  "may_change": ["packages/inn", "packages/terminal", "docs", "SPEC.md"],
  "may_not_change": [
    "packages/core",
    "packages/jev",
    "CLAUDE.md",
    "playtests/loop.json",
    ".github",
    "sdlc",
    "packages/terminal/src/sdlc",
    "packages/terminal/src/sdlc.ts",
    ".claude"
  ],
  "sdlc": {
    "base_branch": "poc",
    "worktree_root": "../rpg-jev.worktrees",
    "trusted_authors": ["lmvdz"],
    "max_build_attempts": 3,
    "max_unanswered": 3,
    "max_tokens_per_pass": 4000000,
    "max_tokens_per_day": 20000000,
    "allow_tool_stages": false,
    "sandbox": {
      "kind": "podman",
      "image": "localhost/rpg-jev-sdlc:1",
      "model_port": 20128,
      "cpus": 4,
      "memory_mb": 6144,
      "pids": 512
    },
    "trusted_reviewers": ["lmvdz", "superagent-security[bot]"],
    "gate_check": "check",
    "agent": {
      "provider": "omniroute",
      "models": {
        "triage": "auto/coding:cheap",
        "plan": "agy/gemini-3.8-flash-high",
        "build": "agy/gemini-3.8-flash-high",
        "review": "auto/coding",
        "pr": "auto/coding"
      },
      "build": {
        "max_turns": 40,
        "max_tokens": 400000,
        "timeout_minutes": 30
      }
    }
  }
}
